{
  "name": "@3lgr/proton-drive-mcp",
  "version": "2.0.0",
  "description": "Hardened fork of proton-drive-mcp: an MCP server and CLI that lets an AI assistant work with Proton Drive and Proton Photos through the official proton-drive CLI, with consent gates the model cannot bypass, a local path allowlist, a sharing policy and untrusted-content handling.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./services/drive": "./dist/services/drive.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "proton-drive-mcp": "dist/index.js",
    "proton-drive-cli": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc",
    "prepare": "node scripts/prepare-build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "cli": "npm run build && node dist/cli.js",
    "test": "npm run build && node --import ./test/helpers/no-index.mjs --test --test-concurrency=4 test/*.test.mjs",
    "test:coverage": "npm run build && node --import ./test/helpers/no-index.mjs --experimental-test-coverage --test-coverage-include=\"dist/**/*.js\" --test --test-concurrency=4 test/*.test.mjs",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "ci": "npm run lint && npm test",
    "pack:check": "npm pack --dry-run",
    "package:mcpb": "node scripts/build-mcpb.mjs",
    "release:check": "npm run lint && npm test && npm run pack:check",
    "prepublishOnly": "node scripts/block-manual-publish.mjs"
  },
  "keywords": [
    "ai",
    "automation",
    "claude",
    "cloud-storage",
    "encryption",
    "hardened",
    "mcp",
    "prompt-injection",
    "proton",
    "proton-drive",
    "security",
    "typescript"
  ],
  "author": {
    "name": "Elger Rodrigues (3lgr)",
    "url": "https://github.com/3lgr"
  },
  "license": "MIT",
  "homepage": "https://github.com/3lgr/proton-drive-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3lgr/proton-drive-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/3lgr/proton-drive-mcp/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "glama.json",
    "smithery.yaml",
    "Dockerfile",
    "SECURITY.md"
  ],
  "optionalDependencies": {
    "fflate": "0.8.3",
    "unpdf": "1.8.1"
  },
  "overrides": {
    "proxy-addr": ">=2.0.8"
  },
  "contributors": [
    {
      "name": "Dawid Piaskowski (googlarz)",
      "url": "https://github.com/googlarz"
    }
  ]
}
